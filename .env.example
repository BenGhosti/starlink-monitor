# Copy this file to .env and fill in real values before starting the stack.

# Dashboard login credentials
ADMIN_USER=admin
ADMIN_PASS=change-me

# Session signing key - REQUIRED, no default. Generate a random one:
#   openssl rand -hex 32
SESSION_SECRET=  # REQUIRED: generate with `openssl rand -hex 32`

# Only set to true once the site is actually served over HTTPS (e.g. behind
# Cloudflare/a reverse proxy) - otherwise the browser silently drops the
# session cookie on login. Leave false for local testing / plain HTTP.
COOKIE_SECURE=false

# 2FA (optional): set TOTP_SECRET to require a 6-digit code at /login too.
# Generate one with: python3 scripts/generate_2fa_secret.py
# Leave empty/commented out to keep 2FA disabled.
# TOTP_SECRET=

# Discord webhook URL for outage/weather/speedtest alerts (optional; leave
# empty to disable Discord notifications)
DISCORD_WEBHOOK=

# Starlink dish gRPC endpoint (default is correct for most setups)
STARLINK_HOST=192.168.100.1
STARLINK_PORT=9200

# Retention tuning (days) - see BACKEND_GUIDE.md for the compression tiers
MINUTELY_RETENTION_DAYS=730
HOURLY_ROLLUP_DAYS=365
