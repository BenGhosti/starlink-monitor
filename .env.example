# Copy this file to .env and fill in real values before starting the stack.

# Dashboard login credentials
ADMIN_USER=admin
ADMIN_PASS=change-me

# Session signing key - REQUIRED, no default. Generate a random one:
#   openssl rand -hex 32
SESSION_SECRET=  # REQUIRED: generate with `openssl rand -hex 32`

# Hardens the session cookie with the Secure flag on HTTPS requests. Plain
# HTTP access (e.g. direct LAN use via the NAS IP) still works - the flag is
# only added when the request is HTTPS. Set true when the site is reachable
# over HTTPS (behind Cloudflare/a reverse proxy).
COOKIE_SECURE=false

# 2FA (optional): set TOTP_SECRET to require a 6-digit code at /login too.
# Generate one with: python3 scripts/generate_2fa_secret.py
# Leave empty/commented out to keep 2FA disabled.
# TOTP_SECRET=

# LAN PIN fallback (optional): for clients inside one of the comma-separated
# CIDRs, this PIN can be entered in the 2FA field instead of a TOTP code.
# Only active when TOTP_SECRET and both values below are set. Meant for
# direct LAN access - never list reverse-proxy/tunnel IPs here, otherwise
# every visitor routed through them counts as LAN.
# LAN_FALLBACK_PIN=change-me
# LAN_FALLBACK_CIDRS=192.168.1.0/24

# Discord webhook URL for outage/weather/speedtest alerts (optional; leave
# empty to disable Discord notifications)
DISCORD_WEBHOOK=

# Starlink dish gRPC endpoint (default is correct for most setups)
STARLINK_HOST=192.168.100.1
STARLINK_PORT=9200

# Speedtest (optional): a nearby speedtest.net server is selected automatically
# around the coordinates below. To pin one specific server instead, set
# SPEEDTEST_SERVER_URL (+ optional SPEEDTEST_SERVER_ID).
# SPEEDTEST_SERVER_LAT=51.3388
# SPEEDTEST_SERVER_LON=6.5853
# SPEEDTEST_SERVER_ID=
# SPEEDTEST_SERVER_URL=

# Retention tuning (days) - see BACKEND_GUIDE.md for the compression tiers
MINUTELY_RETENTION_DAYS=730
HOURLY_ROLLUP_DAYS=365
